{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Goa2V1 ruleset baseline",
  "description": "Default configuration of this rules version. Room overrides belong to runtime state.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "rules_version": {
      "const": "1.0.0-draft.1"
    },
    "players": {
      "const": 4
    },
    "teams": {
      "const": {
        "blue": [
          0,
          2
        ],
        "red": [
          1,
          3
        ]
      }
    },
    "initial_captains": {
      "const": {
        "blue": 0,
        "red": 1
      }
    },
    "starting_crystal_life": {
      "const": 7
    },
    "frontline_victory_marks": {
      "const": 3
    },
    "turns_per_round": {
      "const": 4
    },
    "hand_size": {
      "const": 5
    },
    "starting_hero_level": {
      "const": 1
    },
    "maximum_hero_level": {
      "const": 8
    },
    "movement_cost_per_cell": {
      "const": 1
    },
    "combat_regions": {
      "const": [
        "redNear",
        "mid",
        "blueNear"
      ]
    },
    "initial_combat_region": {
      "const": "mid"
    },
    "minion_defeat_gold": {
      "const": {
        "melee": 2,
        "ranged": 2,
        "heavy": 4
      }
    },
    "hero_defeat_gold": {
      "const": "victim_level"
    },
    "hero_defeat_crystal_loss": {
      "const": "victim_level"
    },
    "assist_gold_by_victim_level": {
      "const": [
        1,
        1,
        1,
        2,
        2,
        2,
        3,
        3
      ]
    },
    "upgrade_cost": {
      "const": "current_hero_level"
    },
    "no_upgrade_compensation_gold": {
      "const": 1
    },
    "purple_unlock_hero_level": {
      "const": 8
    },
    "passive_bonus_per_icon": {
      "const": 1
    },
    "source_rule_ids": {
      "const": [
        "R-SETUP",
        "R-VICTORY",
        "R-ROUND",
        "R-MOVE",
        "R-MINIONS",
        "R-DEFEAT",
        "R-UPGRADE"
      ]
    },
    "initial_minions_per_team": {
      "const": {
        "melee": 4,
        "ranged": 1,
        "heavy": 1
      }
    },
    "spawn_policy": {
      "const": "map_defined_per_combat_region"
    }
  },
  "required": [
    "schema_version",
    "rules_version",
    "players",
    "teams",
    "initial_captains",
    "starting_crystal_life",
    "frontline_victory_marks",
    "turns_per_round",
    "hand_size",
    "starting_hero_level",
    "maximum_hero_level",
    "movement_cost_per_cell",
    "combat_regions",
    "initial_combat_region",
    "minion_defeat_gold",
    "hero_defeat_gold",
    "hero_defeat_crystal_loss",
    "assist_gold_by_victim_level",
    "upgrade_cost",
    "no_upgrade_compensation_gold",
    "purple_unlock_hero_level",
    "passive_bonus_per_icon",
    "source_rule_ids",
    "initial_minions_per_team",
    "spawn_policy"
  ],
  "additionalProperties": false
}
