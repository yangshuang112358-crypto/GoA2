    {
      "Command": "SelectCard",
      "Actor": "p2",
      "Value": "wasp-07-抵挡屏障"
    },
    {
      "Command": "SelectCard",
      "Actor": "p3",
      "Value": "brogan-06-铜墙铁壁"
