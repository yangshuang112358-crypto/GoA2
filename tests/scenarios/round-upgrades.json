{
  "SchemaVersion": 1,
  "Id": "round-upgrades",
  "Name": "连续五轮、多人升级、三色阶梯与紫卡",
  "Steps": [
    { "Command": "DebugPrepare", "Value": "wasp,shargatha,brogan,arien", "Expect": { "Phase": "Planning" } },
    { "Command": "DebugSetGold", "Target": "p1", "Value": "6", "Expect": { "Gold": { "p1": 6 } } },
    { "Command": "DebugSetGold", "Target": "p2", "Value": "1", "Expect": { "Gold": { "p2": 1 } } },
    { "Command": "DebugAdvance", "Value": "round", "Expect": { "Phase": "RoundEnd", "Round": 1, "Turn": 4, "Revealed": 16 } },
    { "Command": "ResolveRoundEnd", "Expect": { "Phase": "RoundEnd", "RoundEndStage": "upgrades", "UpgradingPlayers": 2, "Levels": { "p1": 4, "p2": 2, "p3": 1, "p4": 1 }, "Gold": { "p1": 0, "p2": 0, "p3": 0, "p4": 0 }, "HandCounts": { "p1": 5, "p2": 5, "p3": 5, "p4": 5 }, "EventCounts": { "CardsRecalled": 4, "HeroLeveled": 4 }, "EventOrder": ["RoundEndStarted", "CardsRecalled", "MinionBattleCounted", "MinionBattleCompleted", "HeroLeveled", "UpgradesStarted"] } },
    { "Actor": "p2", "Command": "ChooseUpgrade", "Value": "wasp-03-电能波", "Expect": { "Code": "invalid_upgrade", "UpgradingPlayers": 2 } },
    { "Command": "ChooseUpgrade", "Value": "wasp-03-电能波", "Expect": { "UpgradeCounts": { "p1": 1 }, "EventCounts": { "CardUpgraded": 1, "UpgradeBonusGranted": 1 } } },
    { "Command": "ChooseUpgrade", "Value": "wasp-05-电能爆炸", "Expect": { "Code": "invalid_upgrade", "UpgradeCounts": { "p1": 1 } } },
    { "Actor": "p2", "Command": "ChooseUpgrade", "Value": "shargatha-02-快速突刺", "Expect": { "UpgradingPlayers": 1, "UpgradeCounts": { "p2": 1 } } },
    { "ReplayStep": 9, "Expect": { "Code": "duplicate", "UpgradeCounts": { "p2": 1 }, "EventCounts": { "UpgradeBonusGranted": 0 } } },
    { "Command": "ChooseUpgrade", "Value": "wasp-08-偏转屏障", "Expect": { "UpgradeCounts": { "p1": 2 } } },
    { "Command": "ChooseUpgrade", "Value": "wasp-15-引力控制", "Expect": { "Phase": "Planning", "Round": 2, "Turn": 1, "Revealed": 16, "UpgradingPlayers": 0, "RoundEndStage": "none", "UpgradeCounts": { "p1": 3, "p2": 1 }, "Gold": { "p1": 0, "p2": 0, "p3": 1, "p4": 1 }, "EventCounts": { "RoundCompensationGranted": 2, "RoundEnded": 1, "PlanningStarted": 1 } } },
    { "Command": "DebugAdvance", "Value": "round", "Expect": { "Phase": "RoundEnd", "Round": 2, "Revealed": 32 } },
    { "Command": "ResolveRoundEnd", "Expect": { "UpgradingPlayers": 2, "Levels": { "p3": 2, "p4": 2 }, "Gold": { "p3": 0, "p4": 0 } } },
    { "Actor": "p3", "Command": "ChooseUpgrade", "Value": "brogan-02-投掷飞斧", "Expect": { "UpgradingPlayers": 1 } },
    { "Actor": "p4", "Command": "ChooseUpgrade", "Value": "arien-02-激流", "Expect": { "Phase": "Planning", "Round": 3, "Gold": { "p1": 1, "p2": 1, "p3": 0, "p4": 0 } } },
    { "Command": "DebugSetGold", "Target": "p1", "Value": "22", "Expect": { "Gold": { "p1": 22 } } },
    { "Command": "DebugAdvance", "Value": "round", "Expect": { "Phase": "RoundEnd", "Round": 3, "Revealed": 48 } },
    { "Command": "ResolveRoundEnd", "Expect": { "UpgradingPlayers": 1, "Levels": { "p1": 8 }, "Gold": { "p1": 0 }, "PurpleCards": { "p1": "none" } } },
    { "Command": "ChooseUpgrade", "Value": "wasp-05-电能爆炸", "Expect": { "UpgradeCounts": { "p1": 4 } } },
    { "Command": "ChooseUpgrade", "Value": "wasp-10-反射屏障", "Expect": { "UpgradeCounts": { "p1": 5 } } },
    { "Command": "ChooseUpgrade", "Value": "wasp-17-意念黑洞", "Expect": { "Phase": "Planning", "Round": 4, "UpgradeCounts": { "p1": 6 }, "PurpleCards": { "p1": "wasp-12-电闪雷鸣" }, "HandCounts": { "p1": 5 }, "Gold": { "p1": 0, "p2": 2, "p3": 1, "p4": 1 }, "EventCounts": { "PurpleCardGranted": 1 } } },
    { "Command": "DebugAdvance", "Value": "round", "Expect": { "Phase": "RoundEnd", "Round": 4, "Revealed": 64 } },
    { "Command": "ResolveRoundEnd", "Expect": { "UpgradingPlayers": 1, "Levels": { "p1": 8, "p2": 3, "p3": 2, "p4": 2 } } },
    { "Actor": "p2", "Command": "ChooseUpgrade", "Value": "shargatha-08-统治领域", "Expect": { "Phase": "Planning", "Round": 5, "Turn": 1, "UpgradingPlayers": 0, "Gold": { "p1": 1, "p2": 0, "p3": 2, "p4": 2 }, "UpgradeCounts": { "p1": 6, "p2": 2, "p3": 1, "p4": 1 }, "PurpleCards": { "p1": "wasp-12-电闪雷鸣" }, "HandCounts": { "p1": 5, "p2": 5, "p3": 5, "p4": 5 }, "EventCounts": { "PurpleCardGranted": 0, "RoundCompensationGranted": 3 } } }
  ]
}
