* text=auto eol=lf
*.md text eol=lf
*.json text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.ps1 text eol=lf
*.jpg -text
*.png -text
*.otf -text
# Unity serializes empty YAML fields with a trailing space.
*.meta whitespace=-blank-at-eol
*.asset whitespace=-blank-at-eol
*.unity whitespace=-blank-at-eol
sources/** -text -whitespace
# Historical Player fixtures and inputs preserve the captured bytes and SHA-256.
tests/fixtures/engine*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
tests/fixtures/legacy-v1-roundend.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Preserve captured AI/Unity evidence bytes and their SHA256 across platforms.
docs/verification/ai-stage1-20261007/** -text -whitespace
docs/verification/ai-stage2-20261007/** -text -whitespace
