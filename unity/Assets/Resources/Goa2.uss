.shell { flex-grow: 1; background-color: #101923; color: #e4eae8; padding-left: 18px; padding-right: 18px; }
.header { height: 78px; min-height: 78px; flex-direction: row; align-items: center; border-bottom-width: 1px; border-bottom-color: #30424b; }
.brand { width: 188px; }
.brand-title { font-size: 25px; -unity-font-style: bold; color: #dfbf89; letter-spacing: 3px; }
.eyebrow { font-size: 11px; color: #99aea9; margin-bottom: 5px; letter-spacing: 1px; }
.phase-banner { flex-grow: 1; border-left-width: 1px; border-left-color: #425457; padding-left: 20px; }
.phase-title { font-size: 20px; -unity-font-style: bold; }
.header-controls { flex-direction: row; align-items: center; }
.main { flex-direction: row; flex-grow: 1; min-height: 320px; padding-top: 16px; padding-bottom: 10px; }
.roster { width: 170px; min-width: 170px; margin-right: 16px; }
.seat-card { margin-bottom: 9px; padding: 10px; height: 106px; min-height: 106px; flex-shrink: 0; background-color: #1a2934; border-width: 1px; border-color: #30454e; border-radius: 6px; align-items: flex-start; justify-content: flex-start; }
.seat-card > Label { flex-grow: 0; flex-shrink: 0; }
.seat-card:hover { background-color: #243944; }
.seat-card.blue-seat { border-left-width: 3px; border-left-color: #6eabdf; }
.seat-card.red-seat { border-left-width: 3px; border-left-color: #d0858c; }
.selected-seat { background-color: #2c3d45; border-top-color: #d5b881; border-right-color: #d5b881; border-bottom-color: #d5b881; }
.seat-name { font-size: 18px; -unity-font-style: bold; margin-bottom: 4px; }
.seat-state { font-size: 11px; color: #78cebb; margin-top: 4px; }
.team-info { margin-top: 10px; padding: 12px; border-top-width: 1px; border-top-color: #394e54; }
.field { flex-grow: 1; flex-shrink: 1; min-width: 300px; background-color: #15252d; border-radius: 8px; border-width: 1px; border-color: #2d4349; margin-right: 16px; }
.field-header { height: 42px; min-height: 42px; flex-direction: row; justify-content: space-between; align-items: center; padding-left: 16px; padding-right: 16px; border-bottom-width: 1px; border-bottom-color: #2b3f45; }
.section-title { font-size: 15px; -unity-font-style: bold; margin-bottom: 4px; white-space: normal; }
.hex-board { flex-grow: 1; min-height: 200px; }
.unit-label { position: absolute; color: white; -unity-text-align: middle-center; -unity-font-style: bold; margin: 0; padding: 0; }
.board-footer { min-height: 41px; padding-left: 12px; padding-right: 12px; padding-bottom: 6px; }
.sidebar { width: 296px; min-width: 296px; padding: 14px; background-color: #1a2934; border-width: 1px; border-color: #33494f; border-radius: 8px; }
.panel-title { font-size: 23px; -unity-font-style: bold; margin-bottom: 12px; color: #e6d0a5; }
.body { font-size: 13px; color: #e4eae8; white-space: normal; margin-bottom: 8px; }
.muted { font-size: 12px; color: #aec0bc; white-space: normal; margin-bottom: 5px; }
.tiny { font-size: 11px; color: #a3b7b5; white-space: normal; margin-bottom: 4px; }
.button, .choice-button, .quiet-button, .primary-button { min-height: 31px; padding-left: 10px; padding-right: 10px; padding-top: 6px; padding-bottom: 6px; margin-bottom: 6px; color: #e4eae8; background-color: #273a43; border-width: 1px; border-color: #4a6066; border-radius: 4px; font-size: 12px; white-space: normal; }
.quiet-button { background-color: #1b2c35; border-color: #394e57; }
.header-controls .quiet-button { margin-left: 6px; margin-bottom: 0; }
.primary-button { background-color: #c5a674; color: #152229; border-color: #e1c69c; -unity-font-style: bold; min-height: 35px; }
.button:hover, .choice-button:hover, .quiet-button:hover { background-color: #38505a; border-color: #7c9c9c; }
.primary-button:hover { background-color: #e1c494; }
.button:disabled, .choice-button:disabled, .primary-button:disabled { opacity: .35; }
.chosen { border-width: 2px; border-color: #e5c891; background-color: #35494d; }
.confirm-box { margin-top: 8px; padding-top: 8px; border-top-width: 1px; border-top-color: #506268; }
.card-detail { padding: 10px; margin-top: 4px; margin-bottom: 9px; background-color: #10212c; border-left-width: 2px; border-left-color: #cab180; border-radius: 3px; }
.detail-text { max-height: 110px; min-height: 38px; margin-top: 2px; margin-bottom: 5px; }
.card-rules { white-space: normal; font-size: 12px; color: #d2dfda; margin-bottom: 8px; }
.event-box { margin-top: 12px; padding-top: 9px; border-top-width: 1px; border-top-color: #364d54; }
.hand { height: 170px; min-height: 170px; border-top-width: 1px; border-top-color: #354b52; padding-top: 9px; padding-bottom: 7px; }
.hand-title { flex-direction: row; justify-content: space-between; align-items: center; height: 25px; }
.hand-row { flex-direction: row; flex-grow: 1; }
.hand-card { flex-grow: 1; flex-basis: 0; margin-right: 10px; background-color: #21313c; padding: 10px; border-width: 1px; border-color: #44595e; border-top-width: 3px; border-radius: 5px; align-items: flex-start; }
.hand-card.last-card { margin-right: 0; }
.hand-card:hover { background-color: #30454d; }
.hand-card.spent { opacity: .5; }
.card-name { font-size: 17px; -unity-font-style: bold; margin-bottom: 7px; color: #f0e4d0; white-space: normal; }
.card-zone { font-size: 10px; color: #8dd0c0; margin-top: 3px; }
.color-gold { border-top-color: #e1bf68; }
.color-silver { border-top-color: #abbec8; }
.color-red { border-top-color: #d4838a; }
.color-green { border-top-color: #70bca5; }
.color-blue { border-top-color: #75a8d9; }
.color-purple { border-top-color: #aa8eca; }
.curtain-text { font-size: 15px; -unity-text-align: middle-center; flex-grow: 1; color: #8ca3a7; }
.footer { min-height: 25px; flex-direction: row; justify-content: space-between; align-items: center; border-top-width: 1px; border-top-color: #2d4147; }
.gallery-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: #101923; padding: 24px; }
.gallery-header { flex-direction: row; align-items: center; margin-bottom: 12px; }
.gallery-header .panel-title { flex-grow: 1; }
.gallery-header .muted { margin-right: 20px; }
.gallery-tabs { flex-direction: row; margin-bottom: 8px; }
.gallery-tabs .quiet-button { flex-grow: 1; margin-right: 8px; }
.gallery-note { font-size: 12px; color: #b9c8c0; margin-bottom: 12px; }
.gallery-filters { flex-direction: row; align-items: center; margin-bottom: 10px; }
.gallery-search { flex-grow: 1; height: 40px; margin-right: 12px; font-size: 17px; }
.gallery-search > Label { min-width: 55px; width: 55px; color: #b9c8c0; }
.gallery-search .unity-base-text-field__input { color: #e4eae8; background-color: #152730; padding-left: 9px; padding-right: 9px; }
.gallery-filters .quiet-button { margin-left: 6px; margin-bottom: 0; }
.gallery-scroll { flex-grow: 1; }
.gallery-grid { flex-direction: row; flex-wrap: wrap; }
.gallery-card { width: 268px; min-height: 248px; padding: 16px; margin: 0 14px 14px 0; background-color: #1d303b; border-width: 1px; border-color: #43575e; border-top-width: 4px; border-radius: 6px; }
.status-badge { color: #a5bfb4; font-size: 10px; margin-top: 10px; border-top-width: 1px; border-top-color: #426057; padding-top: 8px; }
.dialog-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(0,0,0,.7); justify-content: center; align-items: center; }
.dialog { width: 420px; padding: 28px; background-color: #23343e; border-width: 1px; border-color: #d4b789; border-radius: 8px; }
.debug-preset-dialog { width: 760px; max-width: 90%; max-height: 94%; padding: 22px; }
.debug-preset-list { min-height: 0; flex-grow: 1; flex-shrink: 1; }
.startup-dialog { width: 620px; max-width: 90%; max-height: 90%; }
.startup-details { max-height: 180px; margin-top: 8px; margin-bottom: 15px; }
.unity-scroller--vertical { width: 9px; min-width: 9px; }
.unity-scroller__low-button, .unity-scroller__high-button { display: none; }
.unity-base-slider__tracker { background-color: #10222d; border-width: 0; }
.unity-base-slider__dragger { background-color: #4a6b73; border-width: 0; border-radius: 4px; }
/* BATCH-02: larger four-sided workspace with persistent map viewport. */
.shell { padding-left: 14px; padding-right: 14px; }
.header { height: 80px; min-height: 80px; }
.brand { width: 180px; }
.brand-title { font-size: 28px; }
.phase-title { font-size: 23px; }
.eyebrow { font-size: 14px; letter-spacing: 0; }
.body { font-size: 17px; }
.muted { font-size: 15px; }
.tiny { font-size: 14px; }
.section-title { font-size: 18px; }
.panel-title { font-size: 26px; }
.card-rules { font-size: 15px; }
.card-name { font-size: 20px; }
.card-zone { font-size: 14px; }
.workspace { flex-direction: row; flex-grow: 1; min-height: 450px; padding-top: 12px; padding-bottom: 10px; }
.left-panel { width: 252px; min-width: 252px; margin-right: 12px; background-color: #14232d; border-width: 1px; border-color: #334b55; border-radius: 6px; }
.right-panel { width: 342px; min-width: 342px; margin-left: 12px; background-color: #192b35; border-width: 1px; border-color: #334b55; border-radius: 6px; }
.center-column { flex-grow: 1; flex-shrink: 1; min-width: 480px; }
.panel-heading { min-height: 42px; height: 42px; flex-direction: row; align-items: center; padding-left: 10px; padding-right: 6px; border-bottom-width: 1px; border-bottom-color: #304953; }
.panel-heading .section-title { flex-grow: 1; margin-bottom: 0; }
.roster-scroll { flex-grow: 1; padding: 8px; }
.seat-card { width: auto; height: 136px; min-height: 136px; margin-bottom: 8px; margin-left: 0; margin-right: 0; padding: 0; }
.seat-name { font-size: 21px; }
.seat-card Label, .hand-card Label { -unity-text-align: middle-left; }
.round-dots { position: absolute; top: 99px; left: 14px; right: 10px; height: 27px; flex-direction: row; align-items: center; }
.bonus-line { font-size: 14px; color: #dcca91; white-space: normal; }
.restriction-text { font-size: 17px; color: #eab5ae; white-space: normal; margin-bottom: 8px; }
.round-dot { width: 24px; height: 24px; margin-right: 17px; border-width: 2px; border-color: #7b939c; border-radius: 20px; background-color: #14232d; }
.filled-dot { border-color: #c5d1d0; }
.discard-dots { position: absolute; top: 137px; left: 14px; right: 7px; flex-direction: row; align-items: center; flex-wrap: wrap; }
.discard-dots .tiny { margin-right: 12px; margin-bottom: 0; }
.discard-dot { width: 19px; height: 19px; border-radius: 20px; margin-right: 8px; }
.team-info { padding: 8px; }
.revealed-panel { height: 232px; min-height: 232px; margin-bottom: 10px; background-color: #172832; border-radius: 6px; border-width: 1px; border-color: #344e58; }
.revealed-row { flex-direction: row; flex-grow: 1; flex-basis: 0; min-height: 0; padding: 6px; }
.revealed-card { flex-grow: 1; flex-basis: 0; min-width: 0; padding: 7px; margin-right: 5px; background-color: #20343f; border-top-width: 3px; border-top-color: #4c626d; border-radius: 4px; overflow: hidden; }
.revealed-card .eyebrow { font-size: 13px; margin-bottom: 1px; }
.revealed-card .tiny { font-size: 13px; margin-bottom: 0; }
.public-card-name { font-size: 18px; color: #f1dfbc; -unity-font-style: bold; white-space: normal; }
.public-card-text { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-height: 30px; margin-top: 3px; margin-bottom: 3px; }
.public-card-text .card-rules { font-size: 14px; }
.active-public-card { background-color: #36484a; border-left-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-color: #dbc18b; border-right-color: #dbc18b; border-bottom-color: #dbc18b; }
.field { min-width: 0; min-height: 130px; margin-right: 0; flex-grow: 1; }
.field-header { height: 41px; min-height: 41px; padding-left: 10px; padding-right: 6px; }
.hex-board { min-height: 60px; overflow: hidden; }
.map-controls { flex-direction: row; }
.board-footer { min-height: 30px; padding-top: 4px; padding-bottom: 3px; margin-bottom: 0; }
.hand { height: 236px; min-height: 236px; padding-top: 0; padding-bottom: 6px; margin-top: 10px; border-width: 1px; border-color: #344e58; border-radius: 6px; }
.hand-row { padding-top: 6px; padding-left: 5px; padding-right: 5px; }
.hand-card { margin-right: 6px; padding: 0; min-width: 0; overflow: hidden; }
.hand-card .card-name { font-size: 19px; }
.hand-card .tiny { font-size: 14px; }
.hand-card .card-zone { font-size: 13px; }
.empty-hand { flex-grow: 1; -unity-text-align: middle-center; font-size: 17px; color: #91aaa9; }
.sidebar { flex-grow: 1; width: auto; min-width: 0; padding: 12px; border-width: 0; background-color: #192b35; }
.button, .choice-button, .quiet-button, .primary-button { min-height: 37px; font-size: 16px; }
.primary-button { min-height: 42px; }
.compact-button, .edge-button, .mode-button, .tab-button, .active-tab { color: #dce9e7; background-color: #243c47; border-width: 1px; border-color: #506b73; border-radius: 4px; font-size: 15px; min-height: 32px; margin: 2px; padding-left: 9px; padding-right: 9px; }
.edge-button { min-width: 34px; }
.mode-button { color: #cfe4b0; margin-right: 8px; }
.tab-button, .active-tab { flex-grow: 1; font-size: 17px; }
.active-tab { border-color: #dec18a; color: #f0d9ac; }
.collapsed-side { width: 43px; min-width: 43px; background-color: #172832; margin-right: 8px; margin-left: 5px; border-radius: 5px; padding-top: 5px; }
.collapsed-side .edge-button { padding-left: 0; padding-right: 0; margin: 4px; min-width: 30px; }
.collapsed-row { height: 43px; min-height: 43px; margin-top: 3px; margin-bottom: 5px; background-color: #172832; border-radius: 4px; }
.debug-button-row { flex-direction: row; flex-wrap: wrap; margin-bottom: 7px; }
.debug-button-row Button { flex-grow: 1; margin-right: 4px; }
.debug-input { min-height: 36px; font-size: 16px; margin-bottom: 8px; color: #dce9e7; }
.debug-input .unity-base-field__label { min-width: 65px; width: 65px; color: #bdd0ce; }
.debug-input .unity-base-field__input { background-color: #0c1d28; color: #eef1e7; border-width: 1px; border-color: #4f727e; font-size: 16px; padding: 5px; }
.debug-toggle { min-height: 34px; color: #dce9e7; margin-bottom: 9px; font-size: 16px; }
.footer { min-height: 29px; }
.gallery-card { width: 290px; }
.gallery-note, .status-badge { font-size: 14px; }
.detail-text { max-height: 175px; }
.scenario-bar { height: 44px; min-height: 44px; flex-direction: row; align-items: center; background-color: #213b43; padding-left: 10px; padding-right: 8px; margin-top: 5px; border-radius: 5px; }
.scenario-info { flex-grow: 1; font-size: 16px; color: #e5d5a9; }

/* BATCH-03: 26px minimum, flowing cards and accessible overflow. */
Label, Button, TextField, IntegerField, FloatField, DropdownField, Toggle,
.body, .tiny, .muted, .eyebrow, .card-rules, .card-zone, .bonus-line, .restriction-text,
.gallery-note, .status-badge, .empty-hand, .scenario-info,
.revealed-card .tiny, .revealed-card .eyebrow, .public-card-text .card-rules,
.hand-card .tiny, .hand-card .card-zone,
.button, .choice-button, .quiet-button, .primary-button, .compact-button, .edge-button, .mode-button, .tab-button, .active-tab,
.debug-input, .debug-input .unity-base-field__input, .debug-toggle, .gallery-search, .gallery-search .unity-base-field__input {
    font-size: 26px;
}
.brand-title, .panel-title { font-size: 34px; }
.phase-title, .section-title, .seat-name, .card-name, .hand-card .card-name, .public-card-name { font-size: 28px; }
.header { height: 112px; min-height: 112px; }
.header-controls { flex-wrap: wrap; justify-content: flex-end; }
.brand { min-width: 180px; }
.phase-banner { min-width: 240px; }
.left-panel { width: 300px; min-width: 300px; }
.right-panel { width: 380px; min-width: 380px; }
.panel-heading { height: 54px; min-height: 54px; }
.button, .choice-button, .quiet-button, .primary-button, .compact-button, .edge-button, .mode-button, .tab-button, .active-tab { min-height: 44px; white-space: normal; }
.debug-input, .debug-toggle { min-height: 44px; }
.debug-input .unity-base-field__label { width: 116px; min-width: 116px; }
.round-dots { height: 38px; }
.round-dot { width: 30px; height: 30px; min-width: 30px; margin-right: 14px; }
.purple-dot { width: 38px; height: 38px; min-width: 38px; border-radius: 24px; border-width: 2px; border-color: #dfc5ff; background-color: #b17ce3; }
.discard-dot { width: 26px; height: 26px; }
.revealed-panel { height: 246px; min-height: 246px; }
.revealed-row { padding: 0; flex-direction: column; }
.revealed-card { width: 230px; min-width: 230px; height: 290px; min-height: 290px; flex-grow: 0; flex-shrink: 0; flex-basis: auto; border-top-width: 0; padding-top: 0; }
.team-stripe { position: absolute; left: 0; right: 0; bottom: 0; height: 6px; min-height: 6px; flex-shrink: 0; }
.card-color-stripe { height: 9px; min-height: 9px; margin-left: -7px; margin-right: -7px; }
.revealed-card .public-card-name { min-height: 34px; }
.field-header { height: auto; min-height: 54px; flex-wrap: wrap; }
.board-footer { min-height: 38px; }
.hand { height: 276px; min-height: 276px; }
.hand-row { flex-grow: 1; flex-direction: column; }
.hand-card { width: 230px; min-width: 230px; min-height: 232px; flex-grow: 0; flex-shrink: 0; flex-basis: auto; padding: 8px; border-top-width: 9px; }
.hand-card .card-name { min-height: 36px; white-space: normal; }
.stat-line { flex-direction: row; align-items: center; min-height: 32px; flex-grow: 0; }
.stat-line > .tiny { flex-grow: 1; margin-bottom: 0; }
.stat-line > .stat-line { flex-grow: 1; margin-right: 8px; }
.passive-plus { color: #6fee91; font-size: 26px; -unity-font-style: bold; margin-left: 8px; }
.footer { min-height: 60px; flex-wrap: wrap; }
.collapsed-row { height: 56px; min-height: 56px; }
.collapsed-side { width: 54px; min-width: 54px; }
.upgrade-panel { flex-grow: 1; height: auto; min-height: 760px; }
.upgrade-row { flex-direction: row; min-height: 224px; margin-bottom: 10px; }
.upgrade-card { flex-grow: 1; flex-basis: 0; min-width: 0; padding: 8px; margin: 5px; border-top-width: 9px; background-color: #20343f; color: #e4eae5; white-space: normal; }
.upgrade-card Label { margin: 0; padding: 0; }
.upgrade-card .card-name { min-height: 0; }
.upgrade-card:disabled { opacity: 0.45; }
.gallery-card { width: 410px; min-width: 410px; flex-shrink: 0; }
.gallery-color-row { flex-shrink: 0; margin-bottom: 18px; }
.gallery-tabs { flex-wrap: wrap; }
.gallery-tabs Button { min-width: 160px; }
.gallery-search { height: 52px; min-height: 52px; }
.gallery-search .unity-base-field__label { width: 80px; min-width: 80px; }
.dialog { width: 620px; }
.purple-preview { position: absolute; width: 500px; padding: 16px; background-color: #211b35; border-width: 2px; border-color: #b17ce3; }
.section-title { color: #d7e5e4; }
.event-box .panel-heading .eyebrow { flex-grow: 1; }

/* Card reading: a compact description in the rail and a full-size, non-scrolling hover card. */
.revealed-panel, .hand { height: 318px; min-height: 318px; }
.hand.upgrade-panel { height: auto; min-height: 760px; }
.hand-card, .revealed-card { width: 348px; min-width: 348px; height: 244px; min-height: 244px; align-items: stretch; }
.hand-card .card-name { min-height: 34px; margin-top: 0; margin-bottom: 2px; }
.hand-card .card-zone { margin-top: 0; margin-bottom: 0; }
.card-rules-preview { width: 100%; font-size: 26px; color: #e0e9e5; white-space: normal; overflow: hidden; text-overflow: clip; height: 64px; min-height: 64px; flex-shrink: 0; margin-top: 0; margin-bottom: 4px; -unity-text-align: upper-left; }
.card-compact-stats { width: 100%; flex-direction: row; flex-wrap: wrap; flex-shrink: 0; margin-top: 2px; }
.card-stat-chip { flex-direction: row; align-items: center; flex-grow: 0; flex-shrink: 0; min-height: 30px; margin-right: 12px; }
.card-stat-chip .tiny { margin-bottom: 0; white-space: nowrap; }
.card-stat-chip .passive-plus { margin-left: 4px; margin-top: 0; margin-bottom: 0; }
.revealed-card .eyebrow { margin-top: 0; margin-bottom: 0; }
.card-preview { position: absolute; padding: 20px; background-color: #172a36; border-width: 2px; border-color: #abc6cc; border-top-width: 9px; border-radius: 6px; }
.card-preview .panel-title { margin-bottom: 6px; }
.card-preview-rules { font-size: 28px; color: #f0f2e9; white-space: normal; margin-top: 12px; margin-bottom: 16px; flex-shrink: 0; }
.card-preview .card-compact-stats { margin-top: 4px; margin-bottom: 8px; }
.card-detail .card-rules { flex-shrink: 0; }
.upgrade-card .card-rules-preview { height: 58px; min-height: 58px; }
.hand-row, .revealed-row { min-height: 0; flex-basis: 0; flex-grow: 1; flex-shrink: 1; }
.hand-card .card-zone { min-height: 30px; flex-shrink: 0; }
.revealed-panel { height: 280px; min-height: 280px; }
.revealed-card { height: 202px; min-height: 202px; padding-bottom: 14px; }
.empty-revealed-panel { height: 140px; min-height: 140px; }
.empty-revealed-panel .revealed-card { height: 60px; min-height: 60px; }
.hand-card .card-rules-preview { -unity-text-align: upper-left; }
.hand { height: 340px; min-height: 340px; }
.hand-card { height: 262px; min-height: 262px; }
.hand-card .card-name { height: 36px; min-height: 36px; padding-top: 0; padding-bottom: 0; }
.card-rules-preview, .upgrade-card .card-rules-preview { white-space: nowrap; height: 80px; min-height: 80px; margin: 0; padding: 0; }
.card-stat-chip { height: 36px; min-height: 36px; }
.card-stat-chip .tiny, .card-stat-chip .passive-plus { margin: 0; padding: 0; }
.card-stat-chip .passive-plus { margin-left: 4px; }
.hand-card .card-zone { height: 34px; min-height: 34px; padding: 0; }
.revealed-card .public-card-name { height: 40px; min-height: 40px; overflow: hidden; }
.keyword-dialog { flex-shrink: 1; }
.keyword-list { min-height: 0; flex-grow: 1; flex-shrink: 1; }
.keyword-entry { margin-bottom: 16px; padding-bottom: 12px; border-bottom-width: 1px; border-bottom-color: #395560; }
